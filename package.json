{
  "name": "lct-games",
  "description": "LCT Games - FE (React) và BE (Hono) là hai Cloudflare Worker riêng",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend",
    "build": "npm run build -w frontend",
    "deploy": "npm run deploy -w frontend && npm run deploy -w backend",
    "deploy:web": "npm run deploy -w frontend",
    "deploy:api": "npm run deploy -w backend",
    "check": "tsc -b && npm run build -w frontend && npm run check -w backend",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "^24.10.1",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "wrangler": "^4.133.0"
  }
}
